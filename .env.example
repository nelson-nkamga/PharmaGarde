# Copier en .env puis exporter ces variables (ou les placer dans le service systemd)
FLASK_ENV=production
SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire      # python3 -c "import secrets; print(secrets.token_hex(32))"
DATABASE_PATH=/var/lib/pharmagarde/pharmagarde.db
SESSION_COOKIE_SECURE=1
PHARMA_DEMO_MODE=0                                          # 1 = affiche les mentions « données illustratives »
# PHARMA_DEMO_NOW=2026-10-15T20:30                          # (démo uniquement) fige l'heure, comme sur les maquettes
